{layout $plugin_ui_layout}
{block page_title}u330 · Fotos{/block}
{block content}
<div class="page-header"><h1>Fotos</h1></div>
{if $flash_success}<div class="alert alert-success">{$flash_success}</div>{/if}
<div class="card">
 <h2>Límites</h2>
 <p>Las fotos se reducen a 1600 px (JPEG, sin datos EXIF). Los archivos viven fuera de la carpeta pública y se sirven solo a quien está en el equipo. Procesar fotos {$gd ? 'está disponible (GD)' : 'NO está disponible: falta la extensión GD de PHP'}.</p>
 <form method="post">
  <input type="hidden" name="_csrf_token" value="{$csrf_token}">
  <p><label>Cuota por equipo (MB) <input class="form-input" type="number" name="cuota_mb" value="{$lim['cuota_mb']}" min="100"></label></p>
  <button class="btn" type="submit">Guardar</button>
 </form>
</div>
<div class="card">
 <h2>Espacio usado por equipo</h2>
 <table class="table"><tr><th>Club</th><th>Equipo</th><th>Archivos</th><th>Espacio</th><th>Cuota</th></tr>
 {foreach $uso as $u}<tr><td>{$u['club']}</td><td>{$u['nombre']}</td><td>{$u['total']}</td><td>{round($u['bytes'] / 1048576, 1)} MB</td><td>{round($u['bytes'] / 1048576 / $lim['cuota_mb'] * 100)} %</td></tr>{/foreach}
 </table>
</div>
{/block}
