{layout '_layout.latte'}
{block titulo}{$t('familia.titulo')} · u330{/block}
{block contenido}
<a class="volver" href="{$url('familia')}">{$ico('arrow-right')|noescape}{$t('volver')}</a>
<h1 style="font-size:34px;margin-bottom:14px">{$t($tipo === 'adulto' ? 'familia.agregar_adulto' : ($tipo === 'hijo' ? 'familia.agregar_hijo' : 'plantel.editar'))}</h1>
<form method="post" action="{$tipo === 'editar' ? $url('familia/hijo/' . $j['id']) : $url('familia/' . $tipo)}" novalidate>
 <input type="hidden" name="csrf" value="{$csrf}">
 <section class="card">
  <label class="campo"><span>{$t('plantel.nombre')}</span><input class="in" type="text" name="nombre" value="{$d['nombre'] ?? ''}" maxlength="160">{if isset($errores['nombre'])}<small class="error" role="alert">{$t($errores['nombre'])}</small>{/if}</label>
  {if $tipo === 'adulto'}
  <label class="campo"><span>{$t('plantel.email')}</span><input class="in" type="email" name="email" value="{$d['email'] ?? ''}" maxlength="190" autocapitalize="off">{if isset($errores['email'])}<small class="error" role="alert">{$t($errores['email'])}</small>{/if}</label>
  <label class="campo"><span>{$t('plantel.telefono')}</span><input class="in" type="tel" name="telefono" value="{$d['telefono'] ?? ''}" maxlength="40"></label>
  {else}
  <label class="campo"><span>{$t('plantel.nacimiento')}</span><input class="in" type="date" name="nacimiento" value="{$d['nacimiento'] ?? ''}">{if isset($errores['nacimiento'])}<small class="error" role="alert">{$t($errores['nacimiento'])}</small>{/if}</label>
  {if $tipo === 'hijo'}
  <label class="campo"><span>{$t('plantel.equipo')}</span>
   <select class="in" name="equipo_id">{foreach $equipos as $q}<option value="{$q['id']}" {if ($d['equipo_id'] ?? '') === $q['id']}selected{/if}>{$q['nombre']}</option>{/foreach}</select>
   {if isset($errores['equipo_id'])}<small class="error" role="alert">{$t($errores['equipo_id'])}</small>{/if}
  </label>
  {/if}
  {/if}
 </section>
 {if $tipo !== 'editar'}<p class="sis">{$ico('shield-check')|noescape}{$t('familia.aprobacion')}</p>{/if}
 <button class="bt s w" type="submit">{$ico($tipo === 'editar' ? 'check' : 'paper-plane-tilt')|noescape}{$t($tipo === 'editar' ? 'plantel.guardar' : 'familia.enviar')}</button>
</form>
{if $tipo === 'editar'}
<section class="card">
 <div class="ch"><h3>{$t('plantel.foto')}</h3></div>
 <form method="post" action="{$url('familia/hijo/' . $j['id'] . '/foto')}" enctype="multipart/form-data" class="foto-form">
  <input type="hidden" name="csrf" value="{$csrf}">
  <div class="foto-sub">{$avatar($j)|noescape}<label class="campo" style="margin:0;flex:1"><span class="sr">{$t('plantel.foto')}</span><input type="file" name="foto" accept="image/jpeg,image/png,image/webp" required></label></div>
  <p class="texto" style="margin:0 0 12px;font-size:13px">{$t('plantel.foto.ayuda')}</p>
  <button class="bt s" type="submit">{$ico('check')|noescape}{$t($j['foto'] ? 'plantel.foto.cambiar' : 'plantel.foto.subir')}</button>
 </form>
 {if $j['foto']}
 <form method="post" action="{$url('familia/hijo/' . $j['id'] . '/foto/quitar')}" style="margin-top:8px"><input type="hidden" name="csrf" value="{$csrf}"><button class="bt w" type="submit">{$ico('x')|noescape}{$t('plantel.foto.quitar')}</button></form>
 {/if}
</section>
{/if}
{/block}
