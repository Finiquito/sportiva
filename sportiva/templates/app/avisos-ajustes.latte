{layout '_layout.latte'}
{block titulo}{$t('avisos.ajustes')} · u330{/block}
{block contenido}
<a class="volver" href="{$url('avisos')}">{$ico('arrow-right')|noescape}{$t('avisos.titulo')}</a>
<h1 style="font-size:34px;margin-bottom:12px">{$t('avisos.ajustes')}</h1>

<section class="card" id="push-bloque" data-vapid="{$vapid}" data-csrf="{$csrf}" data-ok="{$push ? 1 : 0}" data-suscrito="{$suscrito ? 1 : 0}">
 <div class="ch"><h3>{$t('avisos.dispositivo')}</h3></div>
 {if $push}
 <p class="texto" style="margin:0 0 12px" id="push-estado" data-on="{$t('avisos.push.activo')}" data-off="{$t('avisos.push.inactivo')}" data-denied="{$t('avisos.push.denegado')}" data-error="{$t('avisos.push.error')}">{$t($suscrito ? 'avisos.push.activo' : 'avisos.push.inactivo')}</p>
 <button class="bt s" type="button" id="push-boton" hidden data-act="{$t('avisos.push.activar')}" data-off="{$t('avisos.push.desactivar')}">{$ico('bell')|noescape}<span>{$t('avisos.push.activar')}</span></button>
 <p class="sis" style="margin-top:12px" id="push-ayuda">{$ico('device-mobile')|noescape}{$t('avisos.push.iphone')}</p>
 {else}
 <p class="texto" style="margin:0">{$t('avisos.push.no_servidor')}</p>
 {/if}
</section>

<form method="post" action="{$url('avisos/ajustes')}">
 <input type="hidden" name="csrf" value="{$csrf}">
 <section class="card">
  <div class="ch"><h3>{$t('avisos.que')}</h3></div>
  {foreach $categorias as $c}
  <div class="pers" style="display:block">
   <b>{$t('avisos.cat.' . $c)}</b><small>{$t('avisos.cat.' . $c . '.ayuda')}</small>
   <div class="grupo-pills" style="margin:10px 0 0">
    <label class="pill-radio"><input type="checkbox" name="push[{$c}]" value="1" {if $prefs[$c]['push']}checked{/if}><span class="pill">{$ico('bell')|noescape} {$t('avisos.canal.push')}</span></label>
    <label class="pill-radio"><input type="checkbox" name="correo[{$c}]" value="1" {if $prefs[$c]['correo']}checked{/if}><span class="pill">{$ico('paper-plane-tilt')|noescape} {$t('avisos.canal.correo')}</span></label>
   </div>
  </div>
  {/foreach}
  <p class="texto" style="margin:12px 0 0;font-size:13px">{$t('avisos.siempre_campana')}</p>
 </section>
 <button class="bt s w" type="submit">{$ico('check')|noescape}{$t('plantel.guardar')}</button>
</form>
<script n:syntax="off">
(function(){
 var b=document.getElementById('push-bloque'); if(!b||b.dataset.ok!=='1')return;
 var btn=document.getElementById('push-boton'),est=document.getElementById('push-estado'),txt=btn.querySelector('span');
 function u8(s){s=s.replace(/-/g,'+').replace(/_/g,'/');var p=atob(s+'==='.slice((s.length+3)%4)),a=new Uint8Array(p.length);for(var i=0;i<p.length;i++)a[i]=p.charCodeAt(i);return a;}
 function post(u,d){return fetch(u,{method:'POST',headers:{'Content-Type':'application/json','X-CSRF':b.dataset.csrf},body:JSON.stringify(d),credentials:'same-origin'}).then(function(r){return r.json();});}
 if(!('serviceWorker' in navigator)||!('PushManager' in window)||!('Notification' in window)){return;}
 btn.hidden=false;
 navigator.serviceWorker.ready.then(function(reg){return reg.pushManager.getSubscription();}).then(function(s){set(!!s);});
 function set(on){btn.dataset.on=on?'1':'0';txt.textContent=on?btn.dataset.off:btn.dataset.act;est.textContent=on?est.dataset.on:est.dataset.off;}
 btn.addEventListener('click',function(){
  navigator.serviceWorker.ready.then(function(reg){
   return reg.pushManager.getSubscription().then(function(s){
    if(s){var e=s.endpoint;return s.unsubscribe().then(function(){return post('/app/avisos/baja',{endpoint:e});}).then(function(){set(false);});}
    return Notification.requestPermission().then(function(p){
     if(p!=='granted'){est.textContent=est.dataset.denied;return;}
     return reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:u8(b.dataset.vapid)}).then(function(n){var j=n.toJSON();return post('/app/avisos/suscribir',{endpoint:j.endpoint,p256dh:j.keys.p256dh,auth:j.keys.auth});}).then(function(){set(true);});
    });
   });
  }).catch(function(){est.textContent=est.dataset.error;});
 });
})();
</script>
{/block}
