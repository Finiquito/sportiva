{layout '_layout.latte'}
{block titulo}{$t('nav.mas')} · u330{/block}
{block contenido}
<p class="hola">{$persona['nombre']}</p>
<h1>{$t('nav.mas')}</h1>
<section class="card">
 <ul class="lkl">
  <li><span class="lk" style="grid-template-columns:auto minmax(0,1fr)"><span class="fi">{$ico('user-circle')|noescape}</span><span><b>{$persona['nombre']}</b><small>{$persona['email']} · {$t('rol.' . $rol)}</small></span></span></li>
 </ul>
</section>
<section class="card" id="instalar" hidden>
 <div class="ch"><h3>{$t('instalar.titulo')}</h3></div>
 <p class="texto" style="margin:0 0 8px">{$t('instalar.texto')}</p>
 <p class="sis" style="margin:0 0 6px">{$ico('device-mobile')|noescape}<span id="instalar-pasos" data-ios="{$t('instalar.ios')}" data-otro="{$t('instalar.otro')}"></span></p>
</section>
<script n:syntax="off">(function(){var c=document.getElementById('instalar');if(!c)return;var sa=(window.matchMedia&&matchMedia('(display-mode: standalone)').matches)||navigator.standalone;if(sa)return;var ios=/iPhone|iPad|iPod/.test(navigator.userAgent);var p=document.getElementById('instalar-pasos');p.textContent=ios?p.dataset.ios:p.dataset.otro;c.hidden=false;})();</script>
<section class="card">
 <ul class="lkl">
  <li><a class="lk" href="{$url('avisos/ajustes')}" style="grid-template-columns:auto minmax(0,1fr) auto"><span class="fi">{$ico('bell')|noescape}</span><span><b>{$t('avisos.titulo')}</b><small>{$t('avisos.mas.sub')}</small></span><span class="chev">{$ico('arrow-right')|noescape}</span></a></li>
 </ul>
</section>
{if $rol === 'apoderado'}
<section class="card">
 <ul class="lkl">
  <li><a class="lk" href="{$url('familia')}" style="grid-template-columns:auto minmax(0,1fr) auto"><span class="fi">{$ico('users-three')|noescape}</span><span><b>{$t('mas.familia')}</b><small>{$t('mas.familia.sub')}</small></span><span class="chev">{$ico('arrow-right')|noescape}</span></a></li>
 </ul>
</section>
{/if}
<section class="card">
 <div class="ch"><h3>{$t('mas.idioma')}</h3></div>
 <form method="post" action="/app/idioma" class="grupo-pills">
  <input type="hidden" name="csrf" value="{$csrf}">
  {foreach $idiomas as $c => $nombre}
  <button class="pill{if $c === $lang} on{/if}" type="submit" name="idioma" value="{$c}" {if $c === $lang}aria-pressed="true"{/if}>{$nombre}</button>
  {/foreach}
 </form>
</section>
{if count($mem) > 1}
<section class="card">
 <div class="ch"><h3>{$t('mas.clubes')}</h3></div>
 <ul class="lkl">
  <li><a class="lk" href="/app/elegir" style="grid-template-columns:auto minmax(0,1fr) auto"><span class="fi">{$ico('house')|noescape}</span><span><b>{$t('mas.cambiar_club')}</b><small>{count($mem)}</small></span><span class="chev">{$ico('arrow-right')|noescape}</span></a></li>
 </ul>
</section>
{/if}
<form method="post" action="/app/salir">
 <input type="hidden" name="csrf" value="{$csrf}">
 <button class="bt w danger" type="submit">{$t('mas.salir')}</button>
</form>
{/block}
