{layout '_layout.latte'}
{block titulo}{$t('nav.feed')} · u330{/block}
{block claseSheet}{/block}
{block contenido}
<p class="hola">{$t('hola', ['nombre' => $persona['nombre']])}</p>
<h1>{$t('nav.feed')}</h1>
{if $puedePublicar}<a class="bt s" href="{$url('feed/nuevo')}" style="margin-bottom:12px">{$ico('plus')|noescape}{$t('feed.publicar')}</a>{/if}
{var $sig = null}{foreach $items as $it}{if $it['k'] !== 'post' && $it['k'] !== 'medios' && !$sig}{var $sig = $it['p']}{/if}{/foreach}
<div class="dos">
<div class="dos-main">
{if $tieneEquipos || $vista === 'club'}
<div class="grupo-pills">
 {if $tieneEquipos}<a class="pill{if $vista === 'equipo'} on{/if}" href="{$url('feed')}?v=equipo" style="display:inline-flex;align-items:center;text-decoration:none" {if $vista === 'equipo'}aria-current="true"{/if}>{$t('feed.equipo')}</a>{/if}
 <a class="pill{if $vista === 'club'} on{/if}" href="{$url('feed')}?v=club" style="display:inline-flex;align-items:center;text-decoration:none" {if $vista === 'club'}aria-current="true"{/if}>{$t('feed.club')}</a>
</div>
{/if}
{foreach $items as $it}
 {if $it['k'] === 'post'}
 {var $p = $it['p']}
 <article class="card post">
  {if $p['fijado']}<div class="tags"><span class="tag">{$ico('push-pin')|noescape}{$t('feed.fijado')}</span></div>{/if}
  <div class="post-h">
   <span class="avatar">{mb_strtoupper(mb_substr($p['autor'], 0, 1))}</span>
   <div><b>{$p['autor']}</b><small class="sub" style="margin-top:2px">{$p['equipo'] ?: $t('feed.todo_club')} · {$dc($p['created_at'])}</small></div>
  </div>
  {if $p['titulo']}<h2 style="font-size:20px;margin:0 0 8px">{$p['titulo']}</h2>{/if}
  <p class="tx" style="white-space:pre-line">{$p['texto']}</p>
  {if isset($adj[$p['id']])}<a href="{$url('adjunto/' . $adj[$p['id']] . '/f')}" target="_blank" rel="noopener"><img class="adj" src="{$url('adjunto/' . $adj[$p['id']] . '/m')}" alt="{$t('adjunto.foto')}" loading="lazy"></a>{/if}
  <div class="post-f"><a class="bt" href="{$url('feed/' . $p['id'])}">{$ico('chat-circle-dots')|noescape}{if $p['comentarios'] > 0}{$n('feed.comentarios', (int) $p['comentarios'])}{else}{$t('feed.comentar')}{/if}</a></div>
 </article>
 {elseif $it['k'] === 'medios'}
 {var $q = $it['p']}
 <article class="card"><div class="hilo">
  <span class="fi">{$ico('images')|noescape}</span>
  <div><span class="ey">{$t('medios.nuevas')}</span><b>{$q['titulo']}</b><p>{$n('medios.fotos_n', (int) $q['fotos'])} · {$q['equipo']}</p><a class="bt" href="{$url('evento/' . $q['evento_id'] . '/fotos')}">{$t('medios.ver_todo')}</a></div>
 </div></article>
 {else}
 {var $c = $it['p']}
 <article class="card"><div class="hilo">
  <span class="fi lim">{$ico('calendar-blank')|noescape}</span>
  <div><span class="ey">{$t('feed.convocatoria')}</span><b>{$c['titulo']}</b><p>{$dc($c['inicio'])} · {$h($c['inicio'])} · {$c['equipo']}</p><a class="bt" href="{$url('evento/' . $c['id'])}">{$t('abrir')}</a></div>
 </div></article>
 {/if}
{else}
<section class="card vacio"><span class="fi">{$ico('newspaper')|noescape}</span><b>{$t('feed.vacio.titulo')}</b><p>{$t($puedePublicar ? 'feed.vacio.coach' : 'feed.vacio.familia')}</p></section>
{/foreach}
</div>
<aside class="dos-lat solo-escritorio">
 {if $sig}
 <section class="card">
  <div class="ch"><h3>{$t('agenda.proximo')}</h3></div>
  <div class="av" style="padding:0;grid-template-columns:auto minmax(0,1fr)">
   <span class="av-fecha" aria-hidden="true"><small>{$lista('fmt.meses_cortos')[(int) substr($sig['inicio'], 5, 2) - 1]}</small><b>{(int) substr($sig['inicio'], 8, 2)}</b></span>
   <div class="av-txt"><b>{$sig['titulo']}</b><p class="av-cita"><span class="av-dia">{$dc($sig['inicio'])}</span><span class="av-h clave">{$h($sig['inicio'])}</span></p><small>{$sig['equipo']}</small></div>
  </div>
  <a class="bt w" href="{$url('evento/' . $sig['id'])}" style="margin-top:12px">{$t('abrir')}</a>
 </section>
 {/if}
 <a class="bt w" href="{$url('agenda')}">{$ico('calendar-dots')|noescape}{$t('nav.agenda')}</a>
</aside>
</div>
{/block}
