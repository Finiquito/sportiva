{layout '_layout.latte'}
{block titulo}{$t('club.lugar')} · u330{/block}
{block contenido}
<a class="volver" href="{$url('club/lugares')}">{$ico('arrow-right')|noescape}{$t('club.lugares')}</a>
<h1 style="font-size:34px;margin-bottom:12px">{$t($l ? 'club.lugar' : 'club.lugar.nuevo')}</h1>
{if $mapa}{$mapa|noescape}{/if}
{if $enlaces}<div class="grupo-pills" style="margin-top:8px"><a class="pill" href="{$enlaces['google']}" target="_blank" rel="noopener" style="text-decoration:none">Google Maps</a><a class="pill" href="{$enlaces['waze']}" target="_blank" rel="noopener" style="text-decoration:none">Waze</a></div>{/if}
<form method="post" action="{$l ? $url('club/lugares/' . $l['id']) : $url('club/lugares')}" novalidate>
 <input type="hidden" name="csrf" value="{$csrf}">
 <section class="card">
  <label class="campo"><span>{$t('club.lugar.recinto')}</span><input class="in" type="text" name="nombre" value="{$d['nombre'] ?? ''}" maxlength="160">{if isset($errores['nombre'])}<small class="error" role="alert">{$t($errores['nombre'])}</small>{/if}</label>
  <label class="campo"><span>{$t('club.lugar.club_local')}</span><input class="in" type="text" name="club_local" value="{$d['club_local'] ?? ''}" maxlength="160"></label>
  <label class="campo"><span>{$t('campo.direccion')}</span><input class="in" type="text" name="direccion" value="{$d['direccion'] ?? ''}" maxlength="255"></label>
  <label class="campo"><span>{$t('evento.lugar_enlace')}</span><input class="in" type="url" name="enlace" placeholder="https://www.google.com/maps/…"><small>{$t('evento.lugar_enlace_ayuda')}</small></label>
  <label class="campo"><span>{$t('campo.lat')}</span><input class="in" type="text" inputmode="decimal" name="lat" value="{$d['lat'] ?? ''}" maxlength="24" placeholder="46.6">{if isset($errores['lat'])}<small class="error" role="alert">{$t($errores['lat'])}</small>{/if}</label>
  <label class="campo"><span>{$t('campo.lon')}</span><input class="in" type="text" inputmode="decimal" name="lon" value="{$d['lon'] ?? ''}" maxlength="24" placeholder="-0.3"></label>
  <label class="tog" style="display:flex;gap:10px;align-items:center;margin:4px 0 10px"><input type="checkbox" name="local" value="1" {if !empty($d['local'])}checked{/if}><span>{$t('evento.lugar_local')}</span></label>
  <label class="tog" style="display:flex;gap:10px;align-items:center;margin:4px 0 14px"><input type="checkbox" name="predeterminado" value="1" {if !empty($d['predeterminado'])}checked{/if}><span>{$t('club.lugar.predeterminado')}</span></label>
  <button class="bt s" type="submit">{$ico('check')|noescape}{$t('plantel.guardar')}</button>
 </section>
</form>
{if $l}
<form method="post" action="{$url('club/lugares/' . $l['id'] . '/eliminar')}">
 <input type="hidden" name="csrf" value="{$csrf}">
 <button class="bt w danger" type="submit">{$t('club.lugar.eliminar')}</button>
 {if $enUso > 0}<p class="texto" style="font-size:13px">{$n('club.lugar.en_uso', $enUso)}</p>{/if}
</form>
{/if}
{/block}
