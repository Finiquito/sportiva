{layout '_layout.latte'}
{block titulo}{$t('nav.plantel')} · u330{/block}
{block claseSheet}{/block}
{block contenido}
<p class="hola">{$t('hola', ['nombre' => $persona['nombre']])}</p>
<h1>{$t('nav.plantel')}</h1>
<div class="dos">
<div class="dos-main">
{if $pendientes > 0}
<a class="aviso" href="{$url('plantel/solicitudes')}" style="margin-bottom:12px;text-decoration:none;color:inherit"><span class="ia am">{$ico('bell')|noescape}</span><div><b>{$n('plantel.pendientes', $pendientes)}</b><p>{$t('plantel.pendientes.ayuda')}</p></div></a>
{/if}
{if $equipos}
<div class="grupo-pills">
 {foreach $equipos as $q}
 <a class="pill{if $equipo && $q['id'] === $equipo['id']} on{/if}" href="{$url('plantel')}?equipo={$q['id']}" {if $equipo && $q['id'] === $equipo['id']}aria-current="true"{/if} style="display:inline-flex;align-items:center;text-decoration:none">{$q['nombre']}</a>
 {/foreach}
</div>
<a class="bt s" href="{$url('plantel/nuevo')}{if $equipo}?equipo={$equipo['id']}{/if}" style="margin-bottom:12px">{$ico('plus')|noescape}{$t('plantel.nuevo')}</a>
<section class="card">
 <div class="ch"><h3>{$equipo['nombre']} · {$n('plantel.jugadores', count($jugadores))}</h3></div>
 {foreach $jugadores as $j}
 <a class="pers" href="{$url('plantel/jugador/' . $j['id'])}" style="text-decoration:none;color:inherit">
  {$avatar($j)|noescape}
  <span><b>{$j['nombre']}</b><small>{if $j['nacimiento']}{$t('plantel.edad', ['n' => $edad($j['nacimiento'])])} · {/if}{$n('plantel.adultos', (int) $j['adultos'])}</small></span>
  <span class="chev">{$ico('arrow-right')|noescape}</span>
 </a>
 {else}
 <div class="vacio"><span class="fi">{$ico('users-three')|noescape}</span><b>{$t('plantel.vacio.titulo')}</b><p>{$t('plantel.vacio.texto')}</p></div>
 {/foreach}
</section>
{else}
<section class="card vacio"><span class="fi">{$ico('users-three')|noescape}</span><b>{$t('plantel.sin_equipos')}</b></section>
{/if}
</div>
<aside class="dos-lat">
<section class="card" id="locales">
 <div class="ch"><h3>{$t('plantel.locales')}</h3><span class="est">{$ico('map-pin')|noescape}{count($locales)}</span></div>
 <p class="texto" style="margin:0 0 8px;font-size:13px">{$t('plantel.locales.sub')}</p>
 {foreach $locales as $l}
 <div class="pers">
  <span class="fi">{$ico('map-pin')|noescape}</span>
  <div><b>{$l['nombre']}</b>{if $l['direccion']}<small>{$l['direccion']}</small>{/if}</div>
  <form method="post" action="{$url('plantel/locales/' . $l['id'] . '/quitar')}" style="margin:0"><input type="hidden" name="csrf" value="{$csrf}"><button class="bt pill-sm" type="submit" aria-label="{$t('plantel.locales.quitar')}" title="{$t('plantel.locales.quitar')}">{$ico('x')|noescape}</button></form>
 </div>
 {else}
 <p class="texto" style="margin:0 0 8px">{$t('plantel.locales.vacio')}</p>
 {/foreach}
 <form method="post" action="{$url('plantel/locales')}" style="margin-top:12px">
  <input type="hidden" name="csrf" value="{$csrf}">
  {if $otrosLugares}
  <label class="campo"><span>{$t('plantel.locales.elegir')}</span><select class="in" name="lugar_id"><option value="">—</option>{foreach $otrosLugares as $l}<option value="{$l['id']}">{$l['nombre']}</option>{/foreach}</select></label>
  <p class="mini-t">{$t('plantel.locales.nuevo')}</p>
  {/if}
  <label class="campo"><span>{$t('campo.nombre')}</span><input class="in" type="text" name="nombre" maxlength="160"></label>
  <label class="campo"><span>{$t('campo.direccion')}</span><input class="in" type="text" name="direccion" maxlength="255"></label>
  <label class="campo"><span>{$t('evento.lugar_enlace')}</span><input class="in" type="url" name="enlace" placeholder="https://www.google.com/maps/…"></label>
  <button class="bt s" type="submit">{$ico('plus')|noescape}{$t('plantel.locales.agregar')}</button>
 </form>
</section>
</aside>
</div>
{/block}
