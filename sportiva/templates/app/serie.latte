{layout '_layout.latte'}
{block titulo}{$t('serie.titulo')} · u330{/block}
{block contenido}
<a class="volver" href="{$url('agenda')}">{$ico('arrow-right')|noescape}{$t('nav.agenda')}</a>
<p class="hola">{$equipo}</p>
<h1 style="font-size:34px;margin-bottom:6px">{$p['titulo']}</h1>
<p class="sub" style="margin:0 2px 14px">{$t('serie.resumen', ['dias' => implode(', ', array_map(fn($k) => $lista('fmt.dias_cortos')[$k % 7], $dias)), 'hora' => substr((string) $p['inicio'], 0, 5)])}{if $pasadas} · {$n('serie.pasadas', $pasadas)}{/if}</p>
<form method="post" action="{$url('serie/' . $s['id'])}" novalidate>
 <input type="hidden" name="csrf" value="{$csrf}">
 <section class="card">
  <div class="ch"><h3>{$t('evento.fechas')}</h3><span class="est">{count(array_filter($futuras, fn($x) => $x['activa']))} / {count($futuras)}</span></div>
  <p class="texto" style="margin:0 0 10px;font-size:13px">{$t('serie.ayuda')}</p>
  {foreach $futuras as $f}
  <div class="pers" style="display:block">
   <input type="hidden" name="visto[]" value="{$f['fecha']}">
   <label class="tog" style="padding:4px 0"><span><b>{$dl($f['fecha'] . ' 00:00:00')}</b>{if $f['evento_id'] && $f['activa']}<small><a href="{$url('evento/' . $f['evento_id'])}">{$t('abrir')}</a></small>{elseif $f['motivo']}<small>{$t('serie.salta')}: {$f['motivo']}</small>{elseif !$f['activa']}<small>{$t('serie.salta')}</small>{/if}</span><input type="checkbox" name="hacer[{$f['fecha']}]" value="1" {if $f['activa']}checked{/if}></label>
   <label class="campo" style="margin:4px 0 0"><span class="sr">{$t('evento.motivo')}</span><input class="in" type="text" name="motivo[{$f['fecha']}]" value="{$f['motivo']}" maxlength="160" placeholder="{$t('evento.motivo_ph')}"></label>
  </div>
  {else}
  <p class="texto" style="margin:0">{$t('serie.sin_futuras')}</p>
  {/foreach}
 </section>
 <section class="card">
  <div class="ch"><h3>{$t('serie.extender')}</h3></div>
  <div class="grupo-pills">
   {foreach [1, 2, 3, 4, 5, 6, 7] as $k}
   <label class="pill-radio"><input type="checkbox" name="dias[]" value="{$k}" {if in_array($k, $dias, true)}checked{/if}><span class="pill">{$lista('fmt.dias_cortos')[$k % 7]}</span></label>
   {/foreach}
  </div>
  <label class="campo"><span>{$t('serie.extender_meses')}</span>
   <select class="in" name="meses"><option value="0">—</option>{foreach [1, 2, 3, 6] as $m}<option value="{$m}">{$n('evento.n_meses', $m)}</option>{/foreach}</select>
  </label>
  <p class="sis">{$ico('bell')|noescape}{$t('serie.avisa')}</p>
  <button class="bt s w" type="submit">{$ico('check')|noescape}{$t('serie.guardar')}</button>
 </section>
</form>
{/block}
