{layout '_layout.latte'}
{block titulo}{$t('club.invitaciones')} · u330{/block}
{block contenido}
<a class="volver" href="{$url('club')}">{$ico('arrow-right')|noescape}{$t('volver')}</a>
<h1 style="font-size:34px;margin-bottom:12px">{$t('club.invitaciones')}</h1>
<div class="resumen"><span class="pill">{$n('club.n.activos', $activos)}</span><span class="pill">{$n('club.sin_entrar', count($pendientes))}</span></div>
<a class="bt s" href="{$url('club/invitar')}" style="margin:12px 0">{$ico('plus')|noescape}{$t('club.invitar')}</a>
<section class="card">
 <div class="ch"><h3>{$t('club.pendientes')}</h3></div>
 {foreach $pendientes as $p}
 <div class="pers">
  <span class="avatar">{mb_strtoupper(mb_substr($p['nombre'], 0, 1))}</span>
  <span><b>{$p['nombre']}</b><small>{$p['email']}</small></span>
  <form method="post" action="{$url('club/invitaciones/' . $p['id'] . '/reenviar')}" style="margin:0"><input type="hidden" name="csrf" value="{$csrf}"><button class="bt s" type="submit">{$t('club.reenviar')}</button></form>
 </div>
 {else}<p class="texto" style="margin:0">{$t('club.todos_entraron')}</p>{/foreach}
</section>
<form method="post" action="{$url('club/invitaciones/lista')}">
 <input type="hidden" name="csrf" value="{$csrf}">
 <section class="card">
  <div class="ch"><h3>{$t('club.cargar_lista')}</h3></div>
  <p class="texto" style="margin:0 0 10px;font-size:13px">{$t('club.cargar_lista.ayuda')}</p>
  <label class="campo"><span class="sr">{$t('club.cargar_lista')}</span><textarea class="in" name="lista" rows="6" placeholder="ana@correo.com;Ana Pérez;entrenador;U13"></textarea></label>
  <button class="bt s" type="submit">{$ico('paper-plane-tilt')|noescape}{$t('club.cargar_lista.enviar')}</button>
 </section>
</form>
{/block}
