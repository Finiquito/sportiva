{layout '_layout.latte'}
{block titulo}{$t('nav.agenda')} · u330{/block}
{block contenido}
<p class="hola">{$t('hola', ['nombre' => $persona['nombre']])}</p>
<h1>{$t('nav.agenda')}</h1>
{if $coach}<div class="acciones" style="margin:0 0 12px"><a class="bt s" href="{$url('evento/nuevo')}">{$ico('plus')|noescape}{$t('evento.nueva')}</a><a class="bt" href="{$url('turnos')}">{$ico('car')|noescape}{$t('turno.titulo')}</a></div>{/if}
{if $proximo}
 <div class="dia">{$t('agenda.proximo')} · {$ed($proximo[0]['inicio'])}</div>
 {foreach $proximo as $e}
  {include '_evento-card.latte', e: $e, coach: $coach}
 {/foreach}
{/if}
{foreach $dias as $dia => $evs}
 <div class="dia">{$ed($dia . ' 00:00:00')}</div>
 {foreach $evs as $e}
  {include '_evento-card.latte', e: $e, coach: $coach}
 {/foreach}
{else}
 {if !$proximo}
 <section class="card vacio">
  <span class="fi">{$ico('calendar-blank')|noescape}</span>
  <b>{$t('agenda.vacio.titulo')}</b>
  <p>{$t($coach ? 'agenda.vacio.coach' : 'agenda.vacio.familia')}</p>
 </section>
 {/if}
{/foreach}
{if $oculto > 0}<a class="bt w" href="{$url('agenda')}?dias={$masDias}" style="margin-top:12px">{$ico('calendar-dots')|noescape}{$t('agenda.ver_mas')}</a>{/if}
<script n:syntax="off">(function(){document.querySelectorAll('[data-compartir]').forEach(function(a){a.addEventListener('click',function(e){if(!navigator.share)return;e.preventDefault();navigator.share({title:a.dataset.titulo,text:a.dataset.compartir}).catch(function(){});});});})();</script>
{/block}
