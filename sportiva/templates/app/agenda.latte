{layout '_layout.latte'}
{block titulo}{$t('nav.agenda')} · u330{/block}
{block claseSheet}{/block}
{block contenido}
<p class="hola">{$t('hola', ['nombre' => $persona['nombre']])}</p>
<h1>{$t('nav.agenda')}</h1>
{if $coach}<div class="acciones" style="margin:0 0 12px"><a class="bt s" href="{$url('evento/nuevo')}">{$ico('plus')|noescape}{$t('evento.nueva')}</a><a class="bt" href="{$url('turnos')}">{$ico('car')|noescape}{$t('turno.titulo')}</a></div>{/if}
<div class="grupo-pills ag-vista">
 <a class="pill{if $vista === 'lista'} on{/if}" href="{$url('agenda')}" style="display:inline-flex;align-items:center;text-decoration:none" {if $vista === 'lista'}aria-current="true"{/if}>{$ico('newspaper')|noescape}&nbsp;{$t('agenda.vista.lista')}</a>
 <a class="pill{if $vista === 'mes'} on{/if}" href="{$url('agenda')}?vista=mes" style="display:inline-flex;align-items:center;text-decoration:none" {if $vista === 'mes'}aria-current="true"{/if}>{$ico('calendar-dots')|noescape}&nbsp;{$t('agenda.vista.mes')}</a>
</div>
{define dia_eventos}
 <div class="dia">{$ed($diaSel . ' 00:00:00')}</div>
 {foreach $delDia as $e}
  {include '_evento-card.latte', e: $e, coach: $coach}
 {else}
 <section class="card vacio"><span class="fi">{$ico('calendar-blank')|noescape}</span><b>{$t('agenda.dia_vacio')}</b></section>
 {/foreach}
{/define}
{if $vista === 'mes'}
 {include '_calendario.latte', cal: $cal, vista: 'mes', diaSel: $diaSel, mini: false}
 {if $diaSel}{include dia_eventos}{/if}
{else}
<div class="ag-g">
 <div class="ag-main">
 {if $diaSel}
  <a class="volver" href="{$url('agenda')}">{$ico('arrow-right')|noescape}{$t('agenda.volver_proximos')}</a>
  {include dia_eventos}
 {else}
 {if $proximo}
  <div class="dia">{$t('agenda.proximo')} · {$ed($proximo[0]['inicio'])}</div>
  {foreach $proximo as $e}
   {include '_evento-card.latte', e: $e, coach: $coach}
  {/foreach}
 {/if}
 {foreach $dias as $dia => $evs}
  <div class="dia">{$ed($dia . ' 00:00:00')}</div>
  {foreach $evs as $e}
   {include '_evento-card.latte', e: $e, coach: $coach}
  {/foreach}
 {else}
  {if !$proximo && !$pendientes}
  <section class="card vacio">
   <span class="fi">{$ico('calendar-blank')|noescape}</span>
   <b>{$t('agenda.vacio.titulo')}</b>
   <p>{$t($coach ? 'agenda.vacio.coach' : 'agenda.vacio.familia')}</p>
  </section>
  {/if}
 {/foreach}
 {if $pendientes}
  <div class="dia">{$t('agenda.por_confirmar')}</div>
  {foreach $pendientes as $e}
   {include '_evento-card.latte', e: $e, coach: $coach}
  {/foreach}
 {/if}
 {if $oculto > 0}<a class="bt w" href="{$url('agenda')}?dias={$masDias}" style="margin-top:12px">{$ico('calendar-dots')|noescape}{$t('agenda.ver_mas')}</a>{/if}
 {/if}
 </div>
 <aside class="ag-lateral">{include '_calendario.latte', cal: $cal, vista: 'lista', diaSel: $diaSel, mini: true}</aside>
</div>
{/if}
<script n:syntax="off">(function(){document.querySelectorAll('[data-compartir]').forEach(function(a){a.addEventListener('click',function(e){if(!navigator.share)return;e.preventDefault();navigator.share({title:a.dataset.titulo,text:a.dataset.compartir}).catch(function(){});});});})();</script>
{/block}
