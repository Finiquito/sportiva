<!doctype html>
<html lang="{$lang}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0F4F4E">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="manifest" href="/app/manifest.webmanifest">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="u330">
<title>{block titulo}u330{/block}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@700;800&family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap">
<link rel="icon" type="image/svg+xml" href="/app/recurso/favicon">
<link rel="apple-touch-icon" href="/app/recurso/apple-touch-icon">
<link rel="stylesheet" href="/app/estilos?v={$cssv}">
</head>
<body{if $persona} data-sin-leer="{$sinLeer()}"{/if}>
<div class="app{block claseApp}{/block}">
 <header class="band">
  <div class="top">
   <span class="lockup lockup--m">{$logo('principal-verde')|noescape}</span>
   <div class="top-der">
    <span class="chip-club"><span class="mk">{$logo()|noescape}</span>{$club ? $club['nombre'] : 'u330'}</span>
    {if $persona}{var $nl = $sinLeer()}<a class="bell" href="{$url('avisos')}" aria-label="{$nl > 0 ? $t('avisos.campana_n', ['n' => $nl]) : $t('avisos.titulo')}">{$ico('bell')|noescape}{if $nl > 0}<b>{$nl > 9 ? '9+' : $nl}</b>{/if}</a>{/if}
   </div>
  </div>
 </header>
 <div class="cuerpo">
  {if $tabs}
  <nav class="bar" aria-label="{$t('nav.principal')}" style="--n:{count($tabs)}">
   {foreach $tabs as [$k, $icono]}
   <a href="{$url($k)}" class="{if $activa === $k}on{/if}" {if $activa === $k}aria-current="page"{/if}>{$ico($icono, $activa === $k ? 'fill' : 'bold')|noescape}<span>{$t('nav.' . $k)}</span></a>
   {/foreach}
  </nav>
  {/if}
  <main class="sheet {block claseSheet}angosta{/block}">
   {if $flash}<div class="aviso flash" role="status"><span class="ia ok">{$ico('check')|noescape}</span><div><b>{$flash}</b></div></div>{/if}
   {if $flashError}<div class="aviso flash" role="alert"><span class="ia err">{$ico('warning-circle')|noescape}</span><div><b>{$flashError}</b></div></div>{/if}
   {block contenido}{/block}
  <footer class="pie-version" id="pie-version" data-plugin="{$version}">u330 v{$version} · css <span data-css>…</span> <code>{$cssv}</code> <b data-aviso hidden>{$t('pie.css_vieja')}</b></footer>
<script n:syntax="off">(function(){var f=document.getElementById('pie-version');if(!f)return;var v=(getComputedStyle(document.documentElement).getPropertyValue('--css-v')||'').replace(/["'\s]/g,'');f.querySelector('[data-css]').textContent=v||'?';if(v!==f.dataset.plugin){f.classList.add('viejo');f.querySelector('[data-aviso]').hidden=false;}})();</script>
</main>
 </div>
</div>
<script n:syntax="off">
(function(){
 var ov=null,map=null,cargado=null;
 function cargar(){if(cargado)return cargado;cargado=new Promise(function(ok,ko){var l=document.createElement('link');l.rel='stylesheet';l.href='/app/recurso/leaflet-css';document.head.appendChild(l);var s=document.createElement('script');s.src='/app/recurso/leaflet-js';s.onload=ok;s.onerror=ko;document.head.appendChild(s);});return cargado;}
 function abrir(b){
  var d=b.dataset;
  ov=document.createElement('div');ov.className='mapa-full';ov.setAttribute('role','dialog');ov.setAttribute('aria-modal','true');ov.setAttribute('aria-label',d.nombre||'');
  ov.innerHTML='<div class="mf-cab"><b></b><button type="button" class="bt pill-sm mf-x"></button></div><div class="mf-mapa"></div><div class="mf-msg" role="status" hidden></div><div class="mf-pie"><button type="button" class="bt s pill-sm mf-yo"></button><a class="bt pill-sm" target="_blank" rel="noopener">GMaps</a><a class="bt pill-sm" target="_blank" rel="noopener">Waze</a></div>';
  ov.querySelector('b').textContent=d.nombre||'';
  var x=ov.querySelector('.mf-x');x.textContent=d.cerrar;
  var as=ov.querySelectorAll('.mf-pie a');as[0].href=d.google;as[1].href=d.waze;var yo=ov.querySelector('.mf-yo'),msg=ov.querySelector('.mf-msg'),watch=null,miCapa=null;yo.textContent=d.mi;if(!navigator.geolocation)yo.hidden=true;
  document.body.appendChild(ov);document.documentElement.classList.add('mf-abierto');
  function tecla(e){if(e.key==='Escape')cerrar();}
  function cerrar(){if(watch!==null&&navigator.geolocation){navigator.geolocation.clearWatch(watch);}if(map){map.remove();map=null;}ov.remove();document.documentElement.classList.remove('mf-abierto');document.removeEventListener('keydown',tecla);b.focus();}
  x.addEventListener('click',cerrar);document.addEventListener('keydown',tecla);x.focus();
  cargar().then(function(){
   var lat=parseFloat(d.lat),lon=parseFloat(d.lon);
   map=L.map(ov.querySelector('.mf-mapa'),{attributionControl:true}).setView([lat,lon],16);
   var capa=L.tileLayer(d.t1,{maxNativeZoom:16,maxZoom:18,minZoom:4,attribution:'Esri · © OpenStreetMap'}),fallo=false;
   capa.on('tileerror',function(){if(fallo)return;fallo=true;map.removeLayer(capa);L.tileLayer(d.t2,{maxZoom:19,minZoom:4,attribution:'© OpenStreetMap'}).addTo(map);map.setMaxZoom(19);});
   capa.addTo(map);
   L.marker([lat,lon],{keyboard:false,icon:L.divIcon({className:'lpin',html:d.pin,iconSize:[40,40],iconAnchor:[20,40]})}).addTo(map);
   var primera=true,ultima=null,ruta=null,pedido=0;
   function km(a,b){var R=6371,r=Math.PI/180,dl=(b[0]-a[0])*r,dn=(b[1]-a[1])*r,h=Math.sin(dl/2)*Math.sin(dl/2)+Math.cos(a[0]*r)*Math.cos(b[0]*r)*Math.sin(dn/2)*Math.sin(dn/2);return 2*R*Math.asin(Math.sqrt(h));}
   function hora(min){var t=new Date(Date.now()+min*60000);return ('0'+t.getHours()).slice(-2)+':'+('0'+t.getMinutes()).slice(-2);}
   function num(n){return n.toLocaleString(document.documentElement.lang||undefined,{maximumFractionDigits:1});}
   function aviso(txt){msg.textContent=txt;msg.hidden=false;msg.classList.add('est');}
   function estimar(p){
    if(ultima&&km(ultima,p)<0.08)return;ultima=p;var mio=++pedido;
    var url='https://router.project-osrm.org/route/v1/driving/'+p[1]+','+p[0]+';'+lon+','+lat+'?overview=full&geometries=geojson';
    fetch(url).then(function(r){return r.json();}).then(function(j){
     if(mio!==pedido||!map)return;var r=j.routes&&j.routes[0];if(!r)throw 0;
     var min=Math.max(1,Math.round(r.duration/60));
     aviso(d.est.replace('{min}',min).replace('{km}',num(r.distance/1000)).replace('{hora}',hora(min)));
     if(ruta)map.removeLayer(ruta);ruta=L.geoJSON(r.geometry,{style:{color:'#0F4F4E',weight:5,opacity:.75},interactive:false}).addTo(map);
    }).catch(function(){
     if(mio!==pedido||!map)return;var dk=km(p,[lat,lon])*1.35,min=Math.max(1,Math.round(dk/40*60));
     aviso(d.estAprox.replace('{min}',min).replace('{km}',num(dk)));
    });
   }
   function ver(pos){
    if(!map)return;var p=[pos.coords.latitude,pos.coords.longitude],r=pos.coords.accuracy||30;
    if(!miCapa){miCapa={c:L.circle(p,{radius:r,color:'#8a5ee0',weight:1,fillColor:'#8a5ee0',fillOpacity:.14,interactive:false}).addTo(map),m:L.marker(p,{keyboard:false,interactive:false,zIndexOffset:500,icon:L.divIcon({className:'lyo',html:d.yoIco,iconSize:[38,38],iconAnchor:[19,19]})}).addTo(map)};}
    else{miCapa.c.setLatLng(p).setRadius(r);miCapa.m.setLatLng(p);}
    if(primera){primera=false;map.fitBounds(L.latLngBounds([[lat,lon],p]).pad(.35),{maxZoom:16});}
    estimar(p);
   }
   function falla(){aviso(d.miError);msg.classList.remove('est');}
   yo.addEventListener('click',function(){
    if(watch!==null){primera=true;if(miCapa){map.fitBounds(L.latLngBounds([[lat,lon],miCapa.m.getLatLng()]).pad(.35),{maxZoom:16});}return;}
    watch=navigator.geolocation.watchPosition(ver,falla,{enableHighAccuracy:true,maximumAge:5000,timeout:15000});
   });
  }).catch(function(){ov.querySelector('.mf-mapa').textContent='…';});
 }
 document.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('[data-mapa-full]');if(b){e.preventDefault();abrir(b);}});
})();
</script>
<template id="toast-ok"><span class="ia ok">{$ico('check')|noescape}</span></template>
<template id="toast-err"><span class="ia err">{$ico('warning-circle')|noescape}</span></template>
<div id="toast" class="toast" role="status" aria-live="polite" data-ok="{$t('ajax.guardado')}" hidden></div>
<script n:syntax="off">
(function(){
 var main=document.querySelector('main.sheet'),toast=document.getElementById('toast'),tt=null;
 if(!main||!window.fetch||!window.DOMParser||!toast)return;
 function aviso(msg,err){clearTimeout(tt);toast.innerHTML='';var d=document.createElement('div');d.className='aviso flash';var ic=document.getElementById(err?'toast-err':'toast-ok').content.cloneNode(true);d.appendChild(ic);var w=document.createElement('div'),b=document.createElement('b');b.textContent=msg;w.appendChild(b);d.appendChild(w);toast.appendChild(d);toast.hidden=false;toast.classList.remove('sale');void toast.offsetWidth;toast.classList.add('entra');tt=setTimeout(function(){toast.classList.remove('entra');toast.classList.add('sale');setTimeout(function(){toast.hidden=true;},250);},2800);}
 function vivos(n){n.querySelectorAll('script').forEach(function(o){var s=document.createElement('script');s.text=o.text;o.parentNode.replaceChild(s,o);});}
 /* Cambia solo lo que cambió (no se recargan mapas ni fotos que siguen igual). */
 function sync(a,b,nivel){
  var ca=a.children,cb=b.children,i;
  if(nivel>5||ca.length!==cb.length){a.innerHTML=b.innerHTML;vivos(a);return;}
  for(i=0;i<ca.length;i++){
   if(ca[i].outerHTML===cb[i].outerHTML)continue;
   if(ca[i].tagName===cb[i].tagName&&ca[i].children.length&&ca[i].children.length===cb[i].children.length&&ca[i].tagName!=='FORM'&&ca[i].tagName!=='SCRIPT'){sync(ca[i],cb[i],nivel+1);}
   else{var n=cb[i].cloneNode(true);ca[i].replaceWith(n);if(n.tagName==='SCRIPT'){var s=document.createElement('script');s.text=n.text;n.replaceWith(s);}else vivos(n);}
  }
 }
 document.addEventListener('submit',function(e){
  var f=e.target;
  if(!(f instanceof HTMLFormElement)||(f.method||'').toLowerCase()!=='post'||f.dataset.ajax==='no'||(f.enctype||'').indexOf('multipart')===0||!main.contains(f))return;
  var ruta=(f.getAttribute('action')||'');
  if(/\/app\/(salir|idioma|elegir|entrar|codigo)/.test(ruta))return;
  e.preventDefault();
  var bt=e.submitter,fd=new FormData(f),y=window.scrollY;
  if(bt&&bt.name)fd.append(bt.name,bt.value);
  var ok=(bt&&bt.dataset.ok)||f.dataset.ok||toast.dataset.ok;
  if(bt)bt.disabled=true;
  fetch(f.action,{method:'POST',body:fd,credentials:'same-origin',headers:{'X-Requested-With':'fetch'}}).then(function(r){return r.text().then(function(t){return [r,t];});}).then(function(x){
   var r=x[0],d=new DOMParser().parseFromString(x[1],'text/html'),nm=d.querySelector('main.sheet');
   if(!nm){window.location.href=r.url;return;}
   var fl=nm.querySelector('.aviso.flash'),msg=ok,err=false;
   if(fl){msg=fl.textContent.trim()||ok;err=!!fl.querySelector('.err');fl.remove();}
   var mismo=!r.redirected||new URL(r.url).pathname===window.location.pathname;
   ['header.band','nav.bar'].forEach(function(q){var o=document.querySelector(q),n=d.querySelector(q);if(o&&n)o.innerHTML=n.innerHTML;});
   document.body.dataset.sinLeer=d.body.dataset.sinLeer||'0';
   if(navigator.setAppBadge){var c=parseInt(document.body.dataset.sinLeer,10)||0;(c>0?navigator.setAppBadge(c):navigator.clearAppBadge()).catch(function(){});}
   var fl0=main.querySelector('.aviso.flash');if(fl0)fl0.remove();
   if(mismo){sync(main,nm,0);document.title=d.title;var er=main.querySelector('.error[role=alert]');var fe=main.querySelector('#fechas');if(er&&er.getBoundingClientRect().top<0)er.scrollIntoView({block:'center'});else if(fe&&bt&&bt.value==='ver')fe.scrollIntoView({block:'start'});else window.scrollTo(0,y);}
   else{window.history.pushState({},'',r.url);main.innerHTML=nm.innerHTML;vivos(main);document.title=d.title;window.scrollTo(0,0);}
   aviso(msg,err||!!main.querySelector('.error[role=alert]'));
  }).catch(function(){f.submit();});
 });
})();
</script>
<script n:syntax="off">
(function(){document.addEventListener('change',function(e){var i=e.target;if(!i||i.type!=='file'||!(i.closest('.foto-form')||i.dataset.reducir)||!i.files||!i.files[0])return;var f=i.files[0];if(f.size<1200000||!window.DataTransfer||!HTMLCanvasElement.prototype.toBlob)return;var im=new Image(),u=URL.createObjectURL(f);im.onload=function(){var m=+(i.dataset.reducir||1024),k=Math.min(1,m/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);c.getContext('2d').drawImage(im,0,0,c.width,c.height);c.toBlob(function(b){URL.revokeObjectURL(u);if(!b)return;try{var d=new DataTransfer();d.items.add(new File([b],'foto.jpg',{type:'image/jpeg'}));i.files=d.files;}catch(x){}},'image/jpeg',.86);};im.onerror=function(){URL.revokeObjectURL(u);};im.src=u;});})();
</script>
{if $persona}<script n:syntax="off">(function(){var n=parseInt(document.body.dataset.sinLeer||'0',10);if(navigator.setAppBadge){(n>0?navigator.setAppBadge(n):navigator.clearAppBadge()).catch(function(){});}})();</script>
<script n:syntax="off">if('serviceWorker' in navigator){navigator.serviceWorker.register('/app/sw.js',{scope:'/app/'}).catch(function(){});}</script>{/if}
</body>
</html>
