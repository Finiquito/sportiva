<!doctype html>
<html lang="{$lang}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0F4F4E">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="manifest" href="/app/manifest.webmanifest">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="u330">
<title>{block titulo}u330{/block}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@700;800&family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap">
<link rel="icon" type="image/svg+xml" href="/app/recurso/favicon">
<link rel="apple-touch-icon" href="/app/recurso/apple-touch-icon">
<link rel="stylesheet" href="/app/estilos?v={$cssv}">
</head>
<body{if $persona} data-sin-leer="{$sinLeer()}"{/if}>
<div class="app{block claseApp}{/block}">
 <header class="band">
  <div class="top">
   <span class="lockup lockup--m">{$logo('principal-verde')|noescape}</span>
   <div class="top-der">
    <span class="chip-club"><span class="mk">{$logo()|noescape}</span>{$club ? $club['nombre'] : 'u330'}</span>
    {if $persona}{var $nl = $sinLeer()}<a class="bell" href="{$url('avisos')}" aria-label="{$nl > 0 ? $t('avisos.campana_n', ['n' => $nl]) : $t('avisos.titulo')}">{$ico('bell')|noescape}{if $nl > 0}<b>{$nl > 9 ? '9+' : $nl}</b>{/if}</a>{/if}
   </div>
  </div>
 </header>
 <div class="cuerpo">
  {if $tabs}
  <nav class="bar" aria-label="{$t('nav.principal')}" style="--n:{count($tabs)}">
   {foreach $tabs as [$k, $icono]}
   <a href="{$url($k)}" class="{if $activa === $k}on{/if}" {if $activa === $k}aria-current="page"{/if}>{$ico($icono, $activa === $k ? 'fill' : 'bold')|noescape}<span>{$t('nav.' . $k)}</span></a>
   {/foreach}
  </nav>
  {/if}
  <main class="sheet">
   {if $flash}<div class="aviso flash" role="status"><span class="ia ok">{$ico('check')|noescape}</span><div><b>{$flash}</b></div></div>{/if}
   {if $flashError}<div class="aviso flash" role="alert"><span class="ia err">{$ico('warning-circle')|noescape}</span><div><b>{$flashError}</b></div></div>{/if}
   {block contenido}{/block}
  <footer class="pie-version" id="pie-version" data-plugin="{$version}">u330 v{$version} · css <span data-css>…</span> <code>{$cssv}</code> <b data-aviso hidden>{$t('pie.css_vieja')}</b></footer>
<script n:syntax="off">(function(){var f=document.getElementById('pie-version');if(!f)return;var v=(getComputedStyle(document.documentElement).getPropertyValue('--css-v')||'').replace(/["'\s]/g,'');f.querySelector('[data-css]').textContent=v||'?';if(v!==f.dataset.plugin){f.classList.add('viejo');f.querySelector('[data-aviso]').hidden=false;}})();</script>
</main>
 </div>
</div>
<script n:syntax="off">
(function(){document.addEventListener('change',function(e){var i=e.target;if(!i||i.type!=='file'||!(i.closest('.foto-form')||i.dataset.reducir)||!i.files||!i.files[0])return;var f=i.files[0];if(f.size<1200000||!window.DataTransfer||!HTMLCanvasElement.prototype.toBlob)return;var im=new Image(),u=URL.createObjectURL(f);im.onload=function(){var m=+(i.dataset.reducir||1024),k=Math.min(1,m/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);c.getContext('2d').drawImage(im,0,0,c.width,c.height);c.toBlob(function(b){URL.revokeObjectURL(u);if(!b)return;try{var d=new DataTransfer();d.items.add(new File([b],'foto.jpg',{type:'image/jpeg'}));i.files=d.files;}catch(x){}},'image/jpeg',.86);};im.onerror=function(){URL.revokeObjectURL(u);};im.src=u;});})();
</script>
{if $persona}<script n:syntax="off">(function(){var n=parseInt(document.body.dataset.sinLeer||'0',10);if(navigator.setAppBadge){(n>0?navigator.setAppBadge(n):navigator.clearAppBadge()).catch(function(){});}})();</script>
<script n:syntax="off">if('serviceWorker' in navigator){navigator.serviceWorker.register('/app/sw.js',{scope:'/app/'}).catch(function(){});}</script>{/if}
</body>
</html>
