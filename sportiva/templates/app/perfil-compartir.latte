{layout '_layout.latte'}
{block titulo}{$t('perfil.compartir')} · u330{/block}
{block contenido}
<a class="volver" href="{$url('perfil')}">{$ico('arrow-right')|noescape}{$t('perfil.titulo')}</a>
<h1 style="font-size:34px;margin-bottom:12px">{$t('perfil.compartir')}</h1>
<form method="post" action="{$url('perfil/compartir')}">
 <input type="hidden" name="csrf" value="{$csrf}">
 <section class="card">
  <label class="tog" style="display:flex;gap:10px;align-items:center;margin:0 0 12px"><input type="checkbox" name="directorio" value="1" {if $c['directorio']}checked{/if}><span><b>{$t('perfil.compartir.directorio')}</b><br><small>{$t('perfil.compartir.directorio.ayuda')}</small></span></label>
  <label class="tog" style="display:flex;gap:10px;align-items:center;margin:0 0 12px"><input type="checkbox" name="telefono" value="1" {if $c['telefono']}checked{/if}><span><b>{$t('perfil.compartir.telefono')}</b></span></label>
  <label class="tog" style="display:flex;gap:10px;align-items:center;margin:0 0 12px"><input type="checkbox" name="correo" value="1" {if $c['correo']}checked{/if}><span><b>{$t('perfil.compartir.correo')}</b></span></label>
  <p class="sis">{$ico('shield-check')|noescape}{$t('perfil.compartir.nota')}</p>
  <button class="bt s" type="submit">{$ico('check')|noescape}{$t('plantel.guardar')}</button>
 </section>
</form>
{/block}
