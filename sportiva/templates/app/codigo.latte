{layout '_auth.latte'}
{block titulo}{$t('codigo.titulo')} · u330{/block}
{block contenido}
<a class="volver" href="/app/entrar">{$ico('arrow-right')|noescape}{$t('volver')}</a>
<h1>{$t('codigo.titulo')}</h1>
<p class="sub" style="margin:0 2px 16px">{$t('codigo.sub', ['correo' => $oculto])}</p>
<form method="post" action="/app/codigo" novalidate>
 <input type="hidden" name="csrf" value="{$csrf}">
 <label class="campo"><span>{$t('campo.codigo')}</span>
  <input class="in cod-in" type="text" name="codigo" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]*" required autofocus>
  {if $error}<small class="error" role="alert">{$t($error)}</small>{/if}
 </label>
 <button class="bt s w" type="submit">{$t('codigo.entrar')}</button>
</form>
<p class="meta" style="margin-top:16px"><a href="/app/entrar">{$t('codigo.otro')}</a></p>
{/block}
