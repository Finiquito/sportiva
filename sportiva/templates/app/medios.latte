{layout '_layout.latte'}
{block titulo}{$t('medios.titulo')} · u330{/block}
{block contenido}
<a class="volver" href="{$url('evento/' . $e['id'])}">{$ico('arrow-right')|noescape}{$e['titulo']}</a>
<h1 style="font-size:34px;margin-bottom:6px">{$t('medios.titulo')}</h1>
<p class="sub" style="margin:0 2px 14px">{$e['titulo']} · {$dl($e['inicio'])}</p>

{if $puedeSubir}
{if $lleno}
<div class="aviso" style="margin-bottom:12px"><span class="ia err">{$ico('warning-circle')|noescape}</span><div><b>{$t('medios.lleno')}</b><p>{$t('medios.lleno.ayuda')}</p></div></div>
{else}
{if $casiLleno}<div class="aviso" style="margin-bottom:12px"><span class="ia am">{$ico('warning-circle')|noescape}</span><div><b>{$t('medios.casi_lleno')}</b></div></div>{/if}
<section class="card">
 <div class="ch"><h3>{$t('medios.agregar')}</h3></div>
 <form method="post" action="{$url('evento/' . $e['id'] . '/fotos')}" enctype="multipart/form-data" class="fotos-form">
  <input type="hidden" name="csrf" value="{$csrf}">
  <label class="campo"><span>{$t('medios.fotos')}</span><input type="file" name="fotos[]" accept="image/jpeg,image/png,image/webp" multiple required></label>
  <button class="bt s" type="submit">{$ico('camera')|noescape}{$t('medios.subir_fotos')}</button>
 </form>
</section>
{/if}
{/if}

<section class="card">
 <div class="ch"><h3>{$n('medios.cuantos', count($medios))}</h3></div>
 {if $medios}
 <div class="masonry" role="group">
  {foreach $medios as $m}
  <a class="med" href="{$url('medio/' . $m['id'])}" aria-label="{$t('medios.foto')} · {$m['autor']}">
   <img class="foto" src="{$url('medio/' . $m['id'] . '/m')}" alt="" loading="lazy">
  </a>
  {/foreach}
 </div>
 {else}
 <div class="vacio"><span class="fi">{$ico('images')|noescape}</span><b>{$t('medios.vacio')}</b><p>{$t('medios.vacio.texto')}</p></div>
 {/if}
</section>
<p class="sis" style="margin:0 0 12px">{$ico('lock')|noescape}{$t('medios.privacidad')}</p>

{if $puedeSubir && !$lleno}
<script n:syntax="off">
(function(){
 // Reduce las fotos en el teléfono antes de subirlas.
 var ff=document.querySelector('.fotos-form input[type=file]');
 if(ff&&window.DataTransfer&&HTMLCanvasElement.prototype.toBlob){ff.addEventListener('change',function(){
  var fs=Array.prototype.slice.call(ff.files);if(!fs.length)return;var dt=new DataTransfer(),i=0;
  (function sig(){if(i>=fs.length){try{ff.files=dt.files;}catch(x){}return;}var f=fs[i++];
   if(f.size<1500000||f.type==='image/gif'){dt.items.add(f);return sig();}
   var im=new Image(),u=URL.createObjectURL(f);
   im.onload=function(){var k=Math.min(1,1600/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);c.getContext('2d').drawImage(im,0,0,c.width,c.height);
    c.toBlob(function(b){URL.revokeObjectURL(u);dt.items.add(b?new File([b],'foto'+i+'.jpg',{type:'image/jpeg'}):f);sig();},'image/jpeg',.82);};
   im.onerror=function(){URL.revokeObjectURL(u);dt.items.add(f);sig();};im.src=u;})();
 });}
})();
</script>
{/if}
{/block}
