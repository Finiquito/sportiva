{layout '_layout.latte'}
{block titulo}{$t('plantel.solicitudes')} · u330{/block}
{block contenido}
<a class="volver" href="{$url('plantel')}">{$ico('arrow-right')|noescape}{$t('volver')}</a>
<h1 style="font-size:34px;margin-bottom:14px">{$t('plantel.solicitudes')}</h1>
{foreach $lista as $s}
<section class="card">
 <div class="ch"><h3>{$s['tipo'] === 'adulto' ? $t('plantel.sol.adulto') : $t('plantel.sol.hijo')}</h3><span class="est">{$s['equipo'] ?? ''}</span></div>
 <p class="texto" style="margin:0 0 4px"><b>{$s['nombre']}</b>{if $s['tipo'] === 'adulto'} · {$s['email']}{if $s['telefono']} · {$s['telefono']}{/if}{elseif $s['nacimiento']} · {$t('plantel.edad', ['n' => $edad($s['nacimiento'])])}{/if}</p>
 <p class="sub" style="margin:0 0 12px">{$t('plantel.sol.de', ['nombre' => $s['solicitante']])}</p>
 <div class="acciones">
  <form method="post" action="{$url('plantel/solicitudes/' . $s['id'] . '/aprobar')}" style="flex:1"><input type="hidden" name="csrf" value="{$csrf}"><button class="bt s w" type="submit">{$ico('check')|noescape}{$t('plantel.aprobar')}</button></form>
  <form method="post" action="{$url('plantel/solicitudes/' . $s['id'] . '/rechazar')}" style="flex:1"><input type="hidden" name="csrf" value="{$csrf}"><button class="bt w" type="submit">{$ico('x')|noescape}{$t('plantel.rechazar')}</button></form>
 </div>
</section>
{else}
<section class="card vacio"><span class="fi">{$ico('check')|noescape}</span><b>{$t('plantel.sol.vacio')}</b></section>
{/foreach}
{/block}
