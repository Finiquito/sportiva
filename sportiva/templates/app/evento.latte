{layout '_layout.latte'}
{block titulo}{$e['titulo']} · u330{/block}
{block contenido}
<a class="volver" href="{$url('agenda')}">{$ico('arrow-right')|noescape}{$t('nav.agenda')}</a>

<div class="g2">
<div class="col">
 <section class="card ficha-evento">
  <div class="tags">
   {if $e['tipo'] === 'partido'}<span class="tag lim">{$balon()|noescape}{$t('tipo.partido')}</span>
   {elseif $e['tipo'] === 'entreno'}<span class="tag pol">{$propio('silbato')|noescape}{$t('tipo.entreno')}</span>
   {else}<span class="tag">{$ico('sparkle')|noescape}{$t('tipo.' . $e['tipo'])}</span>{/if}
   <span class="tag m">{$e['equipo']}</span>
   {if $e['estado'] === 'cancelado'}<span class="tag">{$t('evento.cancelado_tag')}</span>{/if}
  </div>
  <h1>{$e['titulo']}</h1>
  <p class="cuando">{$ico('calendar-blank')|noescape}<b>{$dl($e['inicio'])}</b></p>
  {if $e['tipo'] === 'partido'}
  <div class="horas" style="margin-top:12px">
   {if $e['hora_encuentro']}
   <div><small>{$ico('users-three')|noescape}{$t('hora.encuentro')}</small><span class="hora"><span class="hl">{$h($e['hora_encuentro'])}</span></span></div><span class="sep"></span>
   <div><small>{$cancha()|noescape}{$t('hora.cancha')}</small><span class="hora">{$h($e['hora_cancha'])}</span></div>
   {else}
   <div><small>{$cancha()|noescape}{$t('hora.cancha')}</small><span class="hora"><span class="hl">{$h($e['hora_cancha'] ?: $e['inicio'])}</span></span></div><span class="sep"></span>
   <div><small>{$ico('timer')|noescape}{$t('hora.partido')}</small><span class="hora">{$h($e['inicio'])}</span></div>
   {/if}
  </div>
  {else}
  <p class="hora-grande">{$h($e['inicio'])}{if $e['fin']} – {$h($e['fin'])}{/if}</p>
  {/if}
  {if $e['hora_encuentro']}
  <div class="punto"><span class="fi">{$ico('users-three')|noescape}</span><div><span class="ey">{$t('evento.punto')}</span><b>{$e['encuentro_texto'] ?: $t('evento.punto_club')}</b></div></div>
  {/if}
  {if $e['lugar']}<p class="lugar-linea">{$ico('map-pin')|noescape}<span><b>{$e['lugar']}</b>{if $e['lugar_direccion']}<small>{$e['lugar_direccion']}</small>{/if}</span></p>{/if}
  {$mapa|noescape}
  <div class="nav">
   {if $enlaces}
   <a class="bt" href="{$enlaces['google']}" target="_blank" rel="noopener">{$ico('navigation-arrow')|noescape}Google Maps</a>
   <a class="bt" href="{$enlaces['waze']}" target="_blank" rel="noopener">{$ico('navigation-arrow')|noescape}Waze</a>
   {/if}
   <a class="bt s" href="https://wa.me/?text={rawurlencode($compartir)}" target="_blank" rel="noopener" data-compartir="{$compartir}" data-titulo="{$e['titulo']}">{$ico('share-network')|noescape}{$t('compartir')}</a>
  </div>
 </section>

 {if $e['nota'] || $rol === 'apoderado' || $rol === 'jugador'}
 <section class="card">
  {if $e['nota']}<p class="texto">{$e['nota']}</p>{/if}

  {if $rol === 'apoderado' && $e['estado'] === 'publicado'}
   {foreach $mios as $j}
   <span class="mini-t" style="margin-top:14px">{$t('asist.tuya')} · {$j['nombre']}</span>
   <form method="post" action="{$url('evento/' . $e['id'] . '/asistencia')}">
    <input type="hidden" name="csrf" value="{$csrf}"><input type="hidden" name="jugador" value="{$j['id']}">
    <div class="voto">
     {foreach [['voy', 'check'], ['duda', 'question'], ['no', 'x']] as [$k, $ic]}
     <button type="submit" name="respuesta" value="{$k}" class="{if $j['respuesta'] === $k}on{/if}" {if $j['respuesta'] === $k}aria-pressed="true"{/if}>{$ico($ic)|noescape}{$t('asist.' . $k . '_largo')}</button>
     {/foreach}
    </div>
   </form>
   {/foreach}
   {if $mios}<a class="bt w" href="{$url('consulta/nueva')}?evento={$e['id']}&amp;jugador={$mios[0]['id']}" style="margin-top:12px">{$ico('chat-circle-dots')|noescape}{$t('consulta.preguntar')}</a>{/if}
  {elseif $rol === 'jugador'}
   {foreach $mios as $j}
   <p class="sis" style="margin-top:14px">{$ico('lock')|noescape}{$t('asist.solo_lectura')}{if $j['respuesta']} · {$t('asist.' . $j['respuesta'] . '_largo')}{/if}</p>
   {/foreach}
  {/if}
 </section>
 {/if}
</div>

<div class="col">
 {if $e['tipo'] === 'partido'}
 <section class="card"><div class="hilo">
  <span class="fi">{$ico('timer')|noescape}</span>
  <div><span class="ey">{$t('evento.en_partido')}</span><b class="hora-mono">{$h($e['inicio'])}</b><p>{$t('evento.en_vivo_pronto')}</p></div>
 </div></section>
 {/if}

 <section class="card">
  <div class="ch"><h3>{$t('evento.citados')}</h3><span class="est">{$resumen['total']}</span></div>
  {if $puede}
  <p class="resumen">
   <span class="est">{$ico('check')|noescape}{$t('asist.voy')} {$resumen['voy']}</span>
   <span class="est">{$ico('question')|noescape}{$t('asist.duda')} {$resumen['duda']}</span>
   <span class="est">{$ico('x')|noescape}{$t('asist.no')} {$resumen['no']}</span>
   <span class="est">{$ico('clock')|noescape}{$t('asist.sin')} {$resumen['sin']}</span>
  </p>
  {/if}
  {foreach $conv as $c}
  <div class="pers">
   {$avatar($c)|noescape}
   <div><b>{$c['nombre']}</b><small>{$c['equipo']}</small></div>
   {if $puede}
   {if $c['respuesta'] === 'voy'}<span class="est">{$ico('check')|noescape}{$t('asist.voy')}</span>
   {elseif $c['respuesta'] === 'duda'}<span class="est">{$ico('question')|noescape}{$t('asist.duda')}</span>
   {elseif $c['respuesta'] === 'no'}<span class="est">{$ico('x')|noescape}{$t('asist.no')}</span>
   {else}<span class="est">{$ico('clock')|noescape}{$t('asist.sin')}</span>{/if}
   {/if}
  </div>
  {else}
  <p class="texto" style="margin:0">{$t('evento.sin_citados')}</p>
  {/foreach}
  {if $puede}<a class="bt w" href="{$url('evento/' . $e['id'] . '/editar')}#citados" style="margin-top:12px">{$ico('pencil-simple')|noescape}{$t('evento.editar_citados')}</a>{/if}
 </section>

 {if !$puede}
 <section class="card">
  <div class="ch"><h3>{$t('asist.confirmaron')}</h3><span class="est">{$resumen['voy']} {$t('de')} {$resumen['total']}</span></div>
  {foreach $conv as $c}
  {if $c['respuesta'] === 'voy'}
  <div class="pers">
   {$avatar($c)|noescape}
   <div><b>{$c['nombre']}</b><small>{$c['equipo']}</small></div>
   <span class="est">{$ico('check')|noescape}{$t('asist.voy')}</span>
  </div>
  {/if}
  {/foreach}
  {if $resumen['voy'] === 0}<p class="texto" style="margin:0">{$t('asist.nadie_confirma')}</p>{/if}
 </section>
 {/if}

 {if $puedeMedios}
 <section class="card">
  <div class="ch"><h3>{$t('medios.titulo')}</h3><span class="est">{$ico('images')|noescape}{$mediosTotal}</span></div>
  {if $medios}
  <div class="masonry">
   {foreach $medios as $m}<a class="med" href="{$url('medio/' . $m['id'])}"><img class="foto" src="{$url('medio/' . $m['id'] . '/m')}" alt="" loading="lazy"></a>{/foreach}
  </div>
  {else}
  <p class="texto" style="margin:0 0 12px">{$t('medios.vacio.texto')}</p>
  {/if}
  <a class="bt w" href="{$url('evento/' . $e['id'] . '/fotos')}">{$ico('camera')|noescape}{$t($mediosTotal > 0 ? 'medios.ver_todo' : 'medios.agregar')}</a>
 </section>
 {/if}

 {if $turnos || $elegibles || $puedePedir || $turnoMio}
 <section class="card" id="turnos">
  {if $turnoMio}
  <div class="traslado" style="grid-template-columns:auto minmax(0,1fr)"><span class="ico">{$ico('car')|noescape}</span><div><span class="ey">{$t('turno.te_toca')}</span><b>{$dc($e['inicio'])} · {$h($e['hora_encuentro'] ?: ($e['hora_cancha'] ?: $e['inicio']))}</b>{if $e['hora_encuentro']}<span class="s">{$e['encuentro_texto'] ?: $t('evento.punto_club')}</span>{/if}</div></div>
  <p class="sis" style="margin:14px 0 6px">{$ico('users-three')|noescape}{$t('turno.sin_cupos')}</p>
  {/if}
  <div class="ch" style="margin-top:{$turnoMio ? 14 : 0}px"><h3>{$t('turno.familias')}</h3><span class="est">{$ico('car')|noescape}{count($turnos)}</span></div>
  {foreach $turnos as $tu}
  <div class="pers">
   <span class="avatar">{mb_strtoupper(mb_substr($tu['nombre'], 0, 1))}</span>
   <div><b>{$tu['nombre']}</b><small>{implode(', ', $tu['hijos'])}</small></div>
   {if $tu['estado'] === 'pendiente'}
    {if $puede}
    <div style="display:flex;gap:6px">
     <form method="post" action="{$url('evento/' . $e['id'] . '/turnos/' . $tu['familia_id'] . '/aceptar')}" style="margin:0"><input type="hidden" name="csrf" value="{$csrf}"><button class="bt s pill-sm" type="submit" aria-label="{$t('turno.aceptar')}">{$ico('check')|noescape}</button></form>
     <form method="post" action="{$url('evento/' . $e['id'] . '/turnos/' . $tu['familia_id'] . '/rechazar')}" style="margin:0"><input type="hidden" name="csrf" value="{$csrf}"><button class="bt pill-sm" type="submit" aria-label="{$t('turno.rechazar')}">{$ico('x')|noescape}</button></form>
    </div>
    {else}<span class="est">{$ico('clock')|noescape}{$t('turno.esperando')}</span>{/if}
   {elseif $puede}
   <form method="post" action="{$url('evento/' . $e['id'] . '/turnos/' . $tu['familia_id'] . '/quitar')}" style="margin:0"><input type="hidden" name="csrf" value="{$csrf}"><button class="bt pill-sm" type="submit" aria-label="{$t('turno.quitar')}">{$ico('x')|noescape}</button></form>
   {else}<span class="est">{$ico('car')|noescape}</span>{/if}
  </div>
  {else}
  <p class="texto" style="margin:0">{$t('turno.vacio')}</p>
  {/foreach}
  {if $puedePedir}
  <form method="post" action="{$url('evento/' . $e['id'] . '/turnos/yo')}"><input type="hidden" name="csrf" value="{$csrf}"><button class="bt w" type="submit" style="margin-top:12px">{$ico('plus')|noescape}{$t('turno.yo_tambien')}</button></form>
  {/if}
  {if $puede && $elegibles}
  <div class="asignar-fila">
  <form method="post" action="{$url('evento/' . $e['id'] . '/turnos/asignar')}" class="asignar">
   <input type="hidden" name="csrf" value="{$csrf}"><input type="hidden" name="volver" value="evento">
   <label class="sr" for="pp-{$e['id']}">{$t('turno.por_partido')}</label>
   <select class="in" id="pp-{$e['id']}" name="por_partido" style="width:auto;min-height:44px">{foreach [1, 2, 3, 4] as $k}<option value="{$k}" {if $k === 2}selected{/if}>{$k}</option>{/foreach}</select>
   <button class="bt s" type="submit">{$ico('car')|noescape}{$t('turno.asignar')}</button>
  </form>
  </div>
  <form method="post" action="{$url('evento/' . $e['id'] . '/turnos')}" style="margin-top:14px">
   <input type="hidden" name="csrf" value="{$csrf}">
   <label class="campo"><span>{$t('turno.agregar')}</span>
    <select class="in" name="familia">{foreach $elegibles as $f}<option value="{$f['id']}">{$f['nombre']}</option>{/foreach}</select>
   </label>
   <button class="bt s" type="submit">{$ico('plus')|noescape}{$t('turno.agregar_btn')}</button>
  </form>
  {/if}
  {if !$turnoMio}<p class="sis" style="margin:12px 0 0">{$ico('users-three')|noescape}{$t('turno.sin_cupos')}</p>{/if}
 </section>
 {/if}

 {if $puede}
 <section class="card">
  <div class="ch"><h3>{$t('evento.gestion')}</h3></div>
  <div class="acciones" style="margin-top:0">
   <a class="bt" href="{$url('evento/' . $e['id'] . '/editar')}">{$t('editar')}</a>
   {if $serie}<a class="bt" href="{$url('serie/' . $serie['id'])}">{$ico('calendar-dots')|noescape}{$t('evento.ver_planificacion')}</a>{/if}
   {if $e['estado'] === 'publicado'}
   <form method="post" action="{$url('evento/' . $e['id'] . '/cancelar')}" style="flex:1 1 auto;display:flex"><input type="hidden" name="csrf" value="{$csrf}"><button class="bt danger w" type="submit">{$t('evento.cancelar')}</button></form>
   {/if}
  </div>
 </section>
 {/if}
</div>
</div>
<script n:syntax="off">(function(){document.querySelectorAll('[data-compartir]').forEach(function(a){a.addEventListener('click',function(e){if(!navigator.share)return;e.preventDefault();navigator.share({title:a.dataset.titulo,text:a.dataset.compartir}).catch(function(){});});});})();</script>
{/block}
